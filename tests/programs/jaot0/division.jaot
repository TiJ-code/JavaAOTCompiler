class Main {
    static void main() {
        printInt(10 / 3);
        printInt(-10 / 3);
        printInt(10 / -3);
        printInt(-10 / -3);
        printInt(20 / 2 * 3);
        printInt(-2147483648 / -1);
        printInt(2147483647 + 1);
        printInt(-2147483648 - 1);
        printInt(50000 * 50000);
    }
}
