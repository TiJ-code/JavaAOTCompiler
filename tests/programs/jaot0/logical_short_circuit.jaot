class Main {
    static boolean markTrue() {
        printInt(42);
        return true;
    }

    static boolean markFalse() {
        printInt(69);
        return false;
    }

    static void main() {
        printBool(false && markTrue());
        printBool(true || markFalse());
        printBool(true && markTrue());
        printBool(false || markFalse());
    }
}