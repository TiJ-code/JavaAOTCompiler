class Node {
}

class Main {
    static Node identity(Node value) {
        return value;
    }

    static Node empty() {
        return null;
    }

    static void showNull(Node value) {
        printBool(value == null);
    }

    static void main() {
        Node original = new Node();
        Node copy = identity(original);

        printBool(copy == original);
        showNull(empty());
        showNull(null);
    }
}