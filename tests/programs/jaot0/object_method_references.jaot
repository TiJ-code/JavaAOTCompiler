class Node {
}

class Helper {
    static boolean same(Node left, Node right) {
        return left == right;
    }
}

class Main {
    static Node identity(Node value) {
        return value;
    }

    static Node empty() {
        return null;
    }

    static void showNull(Node value) {
        printBool(value == null);
    }

    static boolean same(Node left, Node right) {
        return left == right;
    }

    static void main() {
        Node original = new Node();
        Node copy = Main.identity(original);

        printBool(copy == original);
        printBool(Main.same(original, copy));
        printBool(Helper.same(original, copy));
        Main.showNull(Main.empty());
        Main.showNull(null);
    }
}